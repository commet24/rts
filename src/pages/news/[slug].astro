---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import { formatNewsDate, newsSlug } from '@data/news';
import { siteConfig } from '@data/site.config';

export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => data.published);

  return news.map((entry) => ({
    params: { slug: newsSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} | ${siteConfig.siteName}`}
  description={entry.data.description}
>
  <Header />
  <div class="page-shell min-h-screen">
    <main>
      <article class="content-page news-article">
        <a class="back-link" href="/news/">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="margin-right: 0.25rem;"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Все новости
        </a>
        <time datetime={entry.data.date.toISOString()}>
          {formatNewsDate(entry.data.date)}
        </time>
        <h1
          style="font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1; margin-top: 0.5rem;"
        >
          {entry.data.title}
        </h1>
        <p class="article-description">{entry.data.description}</p>
        <div class="article-body">
          <Content />
        </div>
      </article>
    </main>
    <Footer />
  </div>
</BaseLayout>
